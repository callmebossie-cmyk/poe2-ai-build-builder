{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PoE2 Build Architect",
  "version": "0.1.0",
  "identifier": "com.poe2buildarchitect.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PoE2 Build Architect",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:11434"
    }
  },
  "bundle": {
    "active": false
  }
}
